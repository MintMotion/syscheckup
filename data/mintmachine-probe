#
# Lo lanza MintMachine con pkexec solo cuando el usuario pulsa «Leer datos detallados». Hace tres
# cosas y nada más, siempre leyendo, y devuelve JSON por la salida estándar:
#   spd  — copia los datos de los chips SPD de los módulos de memoria tal como los publican los
#          drivers del kernel ee1004 (DDR4) y spd5118 (DDR5). No usa /dev/i2c-* ni escribe en el bus.
#   cpu  — lee una lista cerrada de registros MSR del procesador (multiplicadores, voltaje pedido)
#          y mide el consumo del paquete durante un segundo (RAPL).
#   todo — las dos cosas.
# Si para ello tiene que cargar un módulo del kernel (solo ee1004, spd5118 o msr), lo descarga al
# terminar. No acepta otros argumentos ni rutas.
import glob
import json
import os
import struct
import subprocess
import sys
import time

MODULES = {"ee1004", "spd5118", "msr"}
MSR_AMD = [0xC0010064 + i for i in range(8)] + [0xC0010293, 0xC0010061]
MSR_INTEL = [0xCE, 0x198, 0x1AD]


def loaded(mod):
    return os.path.isdir("/sys/module/" + mod)


MODPROBE = next((p for p in ("/usr/sbin/modprobe", "/sbin/modprobe") if os.access(p, os.X_OK)), None)


def modprobe(*args):
    if not MODPROBE:
        return 1
    try:
        return subprocess.run([MODPROBE, "-q"] + list(args), stdout=subprocess.DEVNULL,
                              stderr=subprocess.DEVNULL, timeout=20).returncode
    except (OSError, subprocess.TimeoutExpired):
        return 1


def load(mod, done):
    if mod in MODULES and not loaded(mod) and modprobe("-b", mod) == 0:
        done.append(mod)


def unload(done):
    for mod in reversed(done):
        modprobe("-r", mod)


def eeproms():
    out = []
    for drv in ("ee1004", "spd5118"):
        for dev in sorted(glob.glob(f"/sys/bus/i2c/drivers/{drv}/*-00[5][0-7]")):
            f = dev + "/eeprom"
            if os.path.isfile(f):
                out.append((drv, os.path.basename(dev), f))
    return out


def spd():
    done, mods = [], []
    if not eeproms():
        for mod in ("ee1004", "spd5118"):
            load(mod, done)
        time.sleep(1.0)
    for drv, bus, f in eeproms():
        try:
            with open(f, "rb") as fh:
                data = fh.read(1024)
        except OSError as e:
            mods.append({"driver": drv, "bus": bus, "error": e.strerror})
            continue
        mods.append({"driver": drv, "bus": bus, "data": data.hex()})
    unload(done)
    adapters = [open_text(a + "/name") for a in glob.glob("/sys/bus/i2c/devices/i2c-*")]
    return {"modules": mods, "loaded": done, "adapters": [a for a in adapters if "SMBus" in a]}


def open_text(path):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return ""


def cpu():
    vendor = "AMD" if "AuthenticAMD" in open_text("/proc/cpuinfo") else (
        "Intel" if "GenuineIntel" in open_text("/proc/cpuinfo") else "")
    fam = next((l.split(":")[1].strip() for l in open_text("/proc/cpuinfo").splitlines()
                if l.startswith("cpu family")), "0")
    res = {"vendor": vendor, "family": int(fam) if fam.isdigit() else 0, "msr": {}, "rapl": {}}
    done = []
    if vendor:
        load("msr", done)
        try:
            fd = os.open("/dev/cpu/0/msr", os.O_RDONLY)
            try:
                for reg in (MSR_AMD if vendor == "AMD" else MSR_INTEL):
                    try:
                        res["msr"][hex(reg)] = struct.unpack("<Q", os.pread(fd, 8, reg))[0]
                    except OSError:
                        pass
            finally:
                os.close(fd)
        except OSError as e:
            res["msr_error"] = e.strerror
        unload(done)
    zones = [z for z in glob.glob("/sys/class/powercap/intel-rapl:*") if z.count(":") == 1]
    first = {z: open_text(z + "/energy_uj") for z in zones}
    t0 = time.monotonic()
    time.sleep(1.0)
    dt = time.monotonic() - t0
    for z in zones:
        a, b = first[z], open_text(z + "/energy_uj")
        if a.isdigit() and b.isdigit() and int(b) >= int(a):
            res["rapl"][open_text(z + "/name") or os.path.basename(z)] = round((int(b) - int(a)) / dt / 1e6, 1)
    return res


def main():
    if os.geteuid() != 0 or len(sys.argv) != 2 or sys.argv[1] not in ("spd", "cpu", "todo"):
        print(json.dumps({"error": "uso: mintmachine-probe spd|cpu|todo (como administrador)"}))
        return 2
    what = sys.argv[1]
    out = {}
    if what in ("spd", "todo"):
        out["spd"] = spd()
    if what in ("cpu", "todo"):
        out["cpu"] = cpu()
    print(json.dumps(out))
    return 0


if __name__ == "__main__":
    sys.exit(main())
