msgstr "Mesure pendant 2 minutes (Ctrl+C pour enregistrer plus tôt)..."

msgid "No se puede abrir la interfaz gráfica ({error}). Falta el paquete python3-gi o gir1.2-gtk-3.0. Se muestra el informe en texto."
msgstr "Impossible d’ouvrir l’interface graphique ({error}). Il manque le paquet python3-gi ou gir1.2-gtk-3.0. Le rapport s’affiche en texte."

msgid "ufw instalado (estado no legible sin root)"
msgstr "ufw installé (état illisible sans root)"

msgid "privativo"
msgstr "propriétaire"

msgid "experimental"
msgstr "expérimental"

msgid "forzado"
msgstr "forcé"

msgid "excelente"
msgstr "excellent"

