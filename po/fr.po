msgstr "Les données personnelles sont masquées."

msgid "Pégalo con Ctrl+V."
msgstr "Collez-le avec Ctrl+V."

msgid "En el foro, pégalo tal cual: ya va entre [code] y [/code]."
msgstr "Sur le forum, collez-le tel quel : il est déjà entre [code] et [/code]."

